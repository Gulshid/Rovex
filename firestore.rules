rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── USERS ──────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                       && request.auth.uid == userId;
      allow update: if request.auth != null
                       && request.auth.uid == userId
                       // role can't be changed after creation
                       && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // ── RIDES ──────────────────────────────────────────────
    match /rides/{rideId} {

      function isRider() {
        return request.auth != null && request.auth.uid == resource.data.riderId;
      }

      function isAssignedDriver() {
        return request.auth != null && request.auth.uid == resource.data.driverId;
      }

      function isClaimingDriver() {
        return request.auth != null
                 && (!('driverId' in resource.data) || resource.data.driverId == null)
                 && request.auth.uid == request.resource.data.driverId;
      }

      function tripFieldsUnchanged() {
        return request.resource.data.riderId == resource.data.riderId
          && request.resource.data.pickupLocation == resource.data.pickupLocation
          && request.resource.data.dropoffLocation == resource.data.dropoffLocation
          && request.resource.data.vehicleType == resource.data.vehicleType
          && request.resource.data.estimatedFare == resource.data.estimatedFare
          && (!('distanceKm' in resource.data) || request.resource.data.distanceKm == resource.data.distanceKm)
          && (!('durationMin' in resource.data) || request.resource.data.durationMin == resource.data.durationMin)
          && (!('paymentMethod' in resource.data) || request.resource.data.paymentMethod == resource.data.paymentMethod)
          && (!('scheduledFor' in resource.data) || request.resource.data.scheduledFor == resource.data.scheduledFor)
          && (!('promoCode' in resource.data) || request.resource.data.promoCode == resource.data.promoCode);
      }

      allow read: if request.auth != null
                     && (resource == null
                         || request.auth.uid == resource.data.riderId
                         || request.auth.uid == resource.data.driverId
                         || resource.data.status == 'requested');

      allow create: if request.auth != null
                       && request.auth.uid == request.resource.data.riderId;

      allow update: if isRider()
                       && tripFieldsUnchanged()
                       && request.resource.data.driverId == resource.data.driverId
                       && (request.resource.data.status == 'cancelled'
                           || (resource.data.status == 'scheduled' && request.resource.data.status == 'requested'));

      allow update: if (isAssignedDriver() || isClaimingDriver())
                       && tripFieldsUnchanged()
                       && request.resource.data.riderId == resource.data.riderId
                       && request.resource.data.driverId == request.auth.uid
                       && request.resource.data.status in ['accepted', 'ongoing', 'completed'];

      allow delete: if false;

      match /ratings/{ratingId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                         && request.auth.uid == request.resource.data.fromUserId;
        allow update: if false;
        allow delete: if false;
      }

      match /messages/{messageId} {
        function rideDoc() {
          return get(/databases/$(database)/documents/rides/$(rideId)).data;
        }

        allow read: if request.auth != null
                       && (request.auth.uid == rideDoc().riderId
                           || request.auth.uid == rideDoc().driverId);

        allow create: if request.auth != null
                         && request.auth.uid == request.resource.data.senderId
                         && (request.auth.uid == rideDoc().riderId
                             || request.auth.uid == rideDoc().driverId);

        allow update: if false;
        allow delete: if false;
      }
    }

    match /promoCodes/{code} {
      allow read: if request.auth != null;
      allow update: if request.auth != null
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redemptionCount']);
      allow create: if false;
      allow delete: if false;
    }

    match /sosAlerts/{alertId} {
      allow create: if request.auth != null
                       && request.auth.uid == request.resource.data.userId;
      allow read: if request.auth != null
                     && request.auth.uid == resource.data.userId;
      allow update: if false;
      allow delete: if false;
    }
  }
}
